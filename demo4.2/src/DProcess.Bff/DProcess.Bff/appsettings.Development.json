{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Idp": {
    "Authority": "https://localhost:7046",
    "ClientId": "bff",
    "ClientSecret": "bff-secret"
  },
  "Bff": {
    "SignedOutLocalPath": "/signed-out"
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7142/"
          }
        }
      }
    }
  }
}
