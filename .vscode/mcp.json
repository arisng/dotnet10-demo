{
    "servers": {
        "sqlite": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-v",
                "C:/Workplace/Demo/dotnet10-demo/demo2/Demo2.DualModeHandoff/Demo2.DualModeHandoff/Data:/mcp",
                "mcp/sqlite",
                "--db-path",
                "/mcp/app.db"
            ]
        },
        "memory": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "env": {
                "MEMORY_FILE_PATH": "${workspaceFolder}/.github/memory.json"
            },
            "type": "stdio"
        }
    }
}