{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "contoso.onmicrosoft.com",
    "TenantId": "common",
    "ClientId": "CHECK-DEMO5-README",
    "ClientSecret": "CHECK-DEMO5-README",
    "CallbackPath": "/signin-oidc"
  },
  "ApiService": {
    "Scopes": [ "api://CHECK-DEMO5-README/Forecast.Read" ]
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**remainder}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://apiservice"
          }
        }
      }
    }
  }
}
