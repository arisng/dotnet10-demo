@page "/admin/role-mappings"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Demo4.EntraIntegration.Shared.Models
@using Demo4.EntraIntegration.Data

<PageTitle>Role Mapping Manager</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Role Mapping Manager</h1>
            <p class="text-muted">Manage mappings between Entra ID App Roles and local application roles.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary" @onclick="ShowCreateDialog">
                <i class="bi bi-plus-circle"></i> Add New Mapping
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (mappings == null || mappings.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No role mappings configured yet.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Entra App Role</th>
                                <th>Local Role</th>
                                <th>Created</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mapping in mappings)
                            {
                                <tr>
                                    <td><code>@mapping.EntraAppRoleValue</code></td>
                                    <td><span class="badge bg-secondary">@mapping.LocalRoleName</span></td>
                                    <td>@mapping.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td>@mapping.Notes</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => ShowEditDialog(mapping)">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMapping(mapping.Id)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit Role Mapping" : "Create Role Mapping")</h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentMapping" OnValidSubmit="SaveMapping" Context="formContext">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="entraRole" class="form-label">Entra App Role Value</label>
                            <InputText id="entraRole" @bind-Value="currentMapping.EntraAppRoleValue" class="form-control" placeholder="e.g., Admin, Manager, User" />
                            <div class="form-text">The value of the app role claim from Entra ID (case-sensitive)</div>
                        </div>

                        <div class="mb-3">
                            <label for="localRole" class="form-label">Local Role</label>
                            <InputSelect id="localRole" @bind-Value="currentMapping.LocalRoleName" class="form-select">
                                <option value="">Select a role...</option>
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                            <div class="form-text">The local application role to assign</div>
                        </div>

                        <div class="mb-3">
                            <label for="notes" class="form-label">Notes (Optional)</label>
                            <InputTextArea id="notes" @bind-Value="currentMapping.Notes" class="form-control" rows="3" placeholder="Optional description or notes" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="HideModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @(isSaving ? "Saving..." : (isEditing ? "Update" : "Create"))
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RoleMappingConfiguration>? mappings;
    private List<string> availableRoles = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private RoleMappingConfiguration currentMapping = new()
    {
        EntraAppRoleValue = "",
        LocalRoleName = "",
        CreatedAt = DateTime.UtcNow
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadMappings();
        await LoadAvailableRoles();
    }

    private async Task LoadMappings()
    {
        try
        {
            mappings = await Http.GetFromJsonAsync<List<RoleMappingConfiguration>>("api/admin/role-mappings");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to load role mappings: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAvailableRoles()
    {
        try
        {
            // Get available roles from the server
            availableRoles = await Http.GetFromJsonAsync<List<string>>("api/admin/roles") ?? new List<string>();
        }
        catch
        {
            // Fallback to common roles if API fails
            availableRoles = new List<string> { "Admin", "Manager", "User" };
        }
    }

    private void ShowCreateDialog()
    {
        currentMapping = new RoleMappingConfiguration
        {
            EntraAppRoleValue = "",
            LocalRoleName = "",
            CreatedAt = DateTime.UtcNow
        };
        isEditing = false;
        showModal = true;
    }

    private void ShowEditDialog(RoleMappingConfiguration mapping)
    {
        currentMapping = new RoleMappingConfiguration
        {
            Id = mapping.Id,
            EntraAppRoleValue = mapping.EntraAppRoleValue,
            LocalRoleName = mapping.LocalRoleName,
            Notes = mapping.Notes,
            CreatedAt = mapping.CreatedAt
        };
        isEditing = true;
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
        currentMapping = new RoleMappingConfiguration
        {
            EntraAppRoleValue = "",
            LocalRoleName = "",
            CreatedAt = DateTime.UtcNow
        };
    }

    private async Task SaveMapping()
    {
        if (string.IsNullOrWhiteSpace(currentMapping.EntraAppRoleValue) ||
            string.IsNullOrWhiteSpace(currentMapping.LocalRoleName))
        {
            return;
        }

        isSaving = true;
        try
        {
            HttpResponseMessage response;
            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/admin/role-mappings/{currentMapping.Id}", new UpdateRoleMappingDto
                {
                    EntraAppRoleValue = currentMapping.EntraAppRoleValue,
                    LocalRoleName = currentMapping.LocalRoleName,
                    Notes = currentMapping.Notes
                });
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/admin/role-mappings", new CreateRoleMappingDto
                {
                    EntraAppRoleValue = currentMapping.EntraAppRoleValue,
                    LocalRoleName = currentMapping.LocalRoleName,
                    Notes = currentMapping.Notes
                });
            }

            if (response.IsSuccessStatusCode)
            {
                HideModal();
                await LoadMappings();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to save: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteMapping(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this role mapping?"))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/admin/role-mappings/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadMappings();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to delete: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }
}
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger">
            <h4>Access Denied</h4>
            <p>You need Admin role to access this page.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>