@using Demo4.EntraIntegration.Authorization
@inject PersistingServerAuthenticationStateProvider PersistingState

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Demo4.EntraIntegration.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="PageRenderMode" />
        <ReconnectModal />
    </CascadingAuthenticationState>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveAuto : null;
    
    // Note: InteractiveAuto will:
    // 1. Prerender on server (SSR)
    // 2. Start as InteractiveServer (SignalR) if WASM isn't ready yet
    // 3. Transition to InteractiveWebAssembly when WASM downloads complete
    // The transition timing depends on WASM download speed and browser caching
}

