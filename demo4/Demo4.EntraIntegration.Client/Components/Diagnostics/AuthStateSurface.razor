@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject ILogger<AuthStateSurface> Logger

<div class="auth-state-surface border rounded p-3 h-100">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h3 class="h6 mb-1">@Title</h3>
            <p class="text-muted small mb-0">@Description</p>
        </div>
        <span class="badge @(IsAuthenticated ? "bg-success" : "bg-secondary")">@(IsAuthenticated ? "Authenticated" : "Anonymous")</span>
    </div>

    <dl class="row small mb-0">
        <dt class="col-5">User</dt>
        <dd class="col-7">@DisplayName</dd>
        <dt class="col-5">Auth Type</dt>
        <dd class="col-7">@AuthType</dd>
        <dt class="col-5">Provider</dt>
        <dd class="col-7">
            @if (IsEntraUser)
            {
                <span class="badge bg-primary">Microsoft Entra ID</span>
            }
            else if (IsAuthenticated)
            {
                <span class="badge bg-info">Local (Passkey/Password)</span>
            }
            else
            {
                <span class="text-muted">N/A</span>
            }
        </dd>
        <dt class="col-5">Claim Count</dt>
        <dd class="col-7">@_claims.Count</dd>
    </dl>

    @if (_claims.Count > 0)
    {
        @if (IsEntraUser)
        {
            <div class="alert alert-info small mt-3 mb-2">
                <strong>Entra ID User Detected</strong><br/>
                Object ID: <code>@EntraObjectId</code><br/>
                Tenant ID: <code>@EntraTenantId</code><br/>
                UPN: <code>@EntraUpn</code>
            </div>

            <div class="card bg-light small mb-2">
                <div class="card-header py-1 px-2"><strong>Graph Profile (Synced)</strong></div>
                <div class="card-body py-1 px-2">
                    <ul class="list-unstyled mb-0">
                        <li><strong>Dept:</strong> @Department</li>
                        <li><strong>Office:</strong> @OfficeLocation</li>
                        <li><strong>Mobile:</strong> @MobilePhone</li>
                        <li><strong>Title:</strong> @JobTitle</li>
                    </ul>
                </div>
            </div>
        }

        <h6 class="mt-3 mb-2">Roles</h6>
        @if (_claims.Any(c => c.Type == ClaimTypes.Role))
        {
            <ul class="small mb-0">
                @foreach (var role in _claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))
                {
                    <li><code>@role</code></li>
                }
            </ul>
        }
        else
        {
            <p class="small text-muted mb-0">No roles assigned</p>
        }

        <h6 class="mt-3 mb-2">Permissions</h6>
        @if (_claims.Any(c => c.Type == "permission"))
        {
            <ul class="small mb-0">
                @foreach (var perm in _claims.Where(c => c.Type == "permission").Select(c => c.Value))
                {
                    <li><code>@perm</code></li>
                }
            </ul>
        }
        else
        {
            <p class="small text-muted mb-0">No permissions assigned</p>
        }

        <details class="mt-3">
            <summary class="h6 mb-2" style="cursor: pointer;">All Claims (@_claims.Count)</summary>
            <ul class="small mt-2 mb-0">
                @foreach (var claim in _claims)
                {
                    <li><strong>@claim.Type:</strong> @claim.Value</li>
                }
            </ul>
        </details>
    }
    else
    {
        <p class="small text-muted mt-2 mb-0">No claims available yet.</p>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public int RenderDelayMs { get; set; } = 2000;

    [CascadingParameter]
    protected Task<AuthenticationState> AuthState { get; set; } = default!;

    private AuthenticationState? _state;
    private readonly List<Claim> _claims = new();

    private bool IsAuthenticated => _state?.User.Identity?.IsAuthenticated == true;
    private string DisplayName => _state?.User.Identity?.Name ?? "Anonymous";
    private string AuthType => _state?.User.Identity?.AuthenticationType ?? "n/a";
    private Task<AuthenticationState>? _lastAuthStateTask;

    // Entra-specific properties
    private bool IsEntraUser => _claims.Any(c => c.Type == "oid");
    private string EntraObjectId => _claims.FirstOrDefault(c => c.Type == "oid")?.Value ?? "N/A";
    private string EntraTenantId => _claims.FirstOrDefault(c => c.Type == "tid")?.Value ?? "N/A";
    private string EntraUpn => _claims.FirstOrDefault(c => c.Type == "preferred_username")?.Value ?? "N/A";

    // Synchronized profile fields
    private string Department => _claims.FirstOrDefault(c => c.Type == "department")?.Value ?? "N/A";
    private string OfficeLocation => _claims.FirstOrDefault(c => c.Type == "office_location")?.Value ?? "N/A";
    private string MobilePhone => _claims.FirstOrDefault(c => c.Type == "mobile_phone")?.Value ?? "N/A";
    private string JobTitle => _claims.FirstOrDefault(c => c.Type == "job_title")?.Value ?? "N/A";

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("AuthStateSurface OnInitializedAsync: RenderDelayMs resolved to {Delay}; Uri={Uri}", RenderDelayMs, Navigation.Uri);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastAuthStateTask != AuthState)
        {
            _lastAuthStateTask = AuthState;

            // Delay before reading state so the component populates incrementally in the UI
            if (RenderDelayMs > 0)
            {
                Logger.LogInformation("AuthStateSurface: delaying {Delay}ms before reading state", RenderDelayMs);
                await Task.Delay(RenderDelayMs);
            }

            await ReadStateAsync();
            Logger.LogInformation("AuthStateSurface OnParametersSetAsync: state updated, triggering render");
        }
    }

    private async Task ReadStateAsync()
    {
        _state = await AuthState;
        _claims.Clear();
        if (_state.User.Identity?.IsAuthenticated == true)
        {
            _claims.AddRange(_state.User.Claims
                .OrderBy(claim => claim.Type, StringComparer.Ordinal));
        }
    }

    public void Dispose()
    {
    }
}
