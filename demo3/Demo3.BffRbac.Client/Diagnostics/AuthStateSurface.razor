@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject ILogger<AuthStateSurface> Logger

<div class="auth-state-surface border rounded p-3 h-100">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h3 class="h6 mb-1">@Title</h3>
            <p class="text-muted small mb-0">@Description</p>
        </div>
        <span class="badge @(IsAuthenticated ? "bg-success" : "bg-secondary")">@(IsAuthenticated ? "Authenticated" : "Anonymous")</span>
    </div>

    <dl class="row small mb-0">
        <dt class="col-5">User</dt>
        <dd class="col-7">@DisplayName</dd>
        <dt class="col-5">Auth Type</dt>
        <dd class="col-7">@AuthType</dd>
        <dt class="col-5">Claim Count</dt>
        <dd class="col-7">@_claims.Count</dd>
    </dl>

    @if (_claims.Count > 0)
    {
        <h6 class="mt-3 mb-2">Roles</h6>
        <ul class="small mb-0">
            @foreach (var role in _claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))
            {
                <li><code>@role</code></li>
            }
        </ul>

        <h6 class="mt-3 mb-2">Permissions</h6>
        <ul class="small mb-0">
            @foreach (var perm in _claims.Where(c => c.Type == "permission").Select(c => c.Value))
            {
                <li><code>@perm</code></li>
            }
        </ul>

        <h6 class="mt-3 mb-2">All Claims</h6>
        <ul class="small mt-2 mb-0">
            @foreach (var claim in _claims)
            {
                <li><strong>@claim.Type:</strong> @claim.Value</li>
            }
        </ul>
    }
    else
    {
        <p class="small text-muted mt-2 mb-0">No claims available yet.</p>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public int RenderDelayMs { get; set; } = 2000;

    [CascadingParameter]
    protected Task<AuthenticationState> AuthState { get; set; } = default!;

    private AuthenticationState? _state;
    private readonly List<Claim> _claims = new();

    private bool IsAuthenticated => _state?.User.Identity?.IsAuthenticated == true;
    private string DisplayName => _state?.User.Identity?.Name ?? "Anonymous";
    private string AuthType => _state?.User.Identity?.AuthenticationType ?? "n/a";
    private Task<AuthenticationState>? _lastAuthStateTask;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("AuthStateSurface OnInitializedAsync: RenderDelayMs resolved to {Delay}; Uri={Uri}", RenderDelayMs, Navigation.Uri);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastAuthStateTask != AuthState)
        {
            _lastAuthStateTask = AuthState;

            // Delay before reading state so the component populates incrementally in the UI
            if (RenderDelayMs > 0)
            {
                Logger.LogInformation("AuthStateSurface: delaying {Delay}ms before reading state", RenderDelayMs);
                await Task.Delay(RenderDelayMs);
            }

            await ReadStateAsync();
            Logger.LogInformation("AuthStateSurface OnParametersSetAsync: state updated, triggering render");
        }
    }

    private async Task ReadStateAsync()
    {
        _state = await AuthState;
        _claims.Clear();
        if (_state.User.Identity?.IsAuthenticated == true)
        {
            _claims.AddRange(_state.User.Claims
                .OrderBy(claim => claim.Type, StringComparer.Ordinal));
        }
    }

    public void Dispose()
    {
    }
}
